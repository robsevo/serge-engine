# ─── Build output ───────────────────────────────────────────────────────────
dist/
*.tsbuildinfo

# ─── Dependencies ───────────────────────────────────────────────────────────
node_modules/

# ─── Conformance run artifacts ──────────────────────────────────────────────
# Each run creates a throwaway SERGE_HOME and a probe log. The generated
# contract in docs/ IS committed — it is the deliverable.
tests/conformance/.runs/

# ─── Secrets ────────────────────────────────────────────────────────────────
.env
.env.*
!.env.example
*.key
*.pem

# ─── Generated at install time ───────────────────────────────────────────────
package-lock.json

# Ink/React are real dependencies now — installed, not vendored.
node_modules/

# Secrets. Nothing here reads an env FILE today — it takes env vars from the
# process — so this is a trap-closer, not a fix: a serge.env dropped in later
# must not be committable.
serge.env
router.env
*.env
!*.env.template
!*.env.example
