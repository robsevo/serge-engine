{
  "name": "serge-engine",
  "version": "0.0.0",
  "private": true,
  "description": "An MIT-licensed, Claude Code-compatible agent engine for serge-public.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "conformance": "node tests/conformance/run.mjs",
    "conformance:self-test": "node tests/conformance/run.mjs --self-test",
