#!/usr/bin/env bash
#
# serge-engine launcher.
#
# install.sh:117 looks for this file FIRST, before bin/*. That ordering matters:
# everything below runs before the engine starts, and a bare node wrapper sets
# none of it — an engine launched without CLAUDE_CODE_USE_OPENAI / OPENAI_BASE_URL
# silently falls back to whatever provider it was built against.
set -euo pipefail

resolve_self() {
  readlink -f "$1" 2>/dev/null || greadlink -f "$1" 2>/dev/null \
    || python3 -c 'import os,sys;print(os.path.realpath(sys.argv[1]))' "$1"
}
SCRIPT_DIR="$(cd "$(dirname "$(resolve_self "${BASH_SOURCE[0]}")")" && pwd)"
DIST="$SCRIPT_DIR/dist/cli.mjs"
SERGE_HOME="${SERGE_HOME:-$HOME/.serge}"

# Keep config fully separate from a real Claude Code install (~/.claude).
export CLAUDE_CONFIG_DIR="$SERGE_HOME"

# The name the user actually typed. argv[1] inside node is always dist/cli.mjs,
# so every "run this next" line the engine prints would otherwise say `serge`
# even when a wrapper drove it under another name against another config dir —
# and following that hint lands in the wrong install's transcripts. Already-set
# wins, so a wrapper can claim the name before exec'ing this script.
export SERGE_CLI_NAME="${SERGE_CLI_NAME:-$(basename "$0")}"

# Router. The engine speaks OpenAI-compatible HTTP and nothing else.
export CLAUDE_CODE_USE_OPENAI=1
export OPENAI_BASE_URL="${OPENAI_BASE_URL:-http://localhost:4000/v1}"
export OPENAI_API_KEY="${OPENAI_API_KEY:-sk-noop}"
export OPENAI_MODEL="${OPENAI_MODEL:-local-coder}"

# keys.env is the single file a new user fills in; router.env and serge.env
# remain for existing installs. Sourced LAST so a filled keys.env wins over the
# blank router.env a fresh install ships.
[ -f "$SERGE_HOME/router.env" ] && { set -a; . "$SERGE_HOME/router.env"; set +a; }
[ -f "$SERGE_HOME/serge.env" ]  && { set -a; . "$SERGE_HOME/serge.env";  set +a; }
[ -f "$SERGE_HOME/keys.env" ]   && { set -a; . "$SERGE_HOME/keys.env";   set +a; }

if [ ! -f "$DIST" ]; then
  echo "serge-engine: dist/cli.mjs not found. Build first:  npm run build" >&2
  exit 1
fi

# Bring the router up if it is not answering, the same way serge does.
ROUTER_ROOT="${OPENAI_BASE_URL%/v1}"
if ! curl -sf "${ROUTER_ROOT}/v1/models" >/dev/null 2>&1; then
  if command -v systemctl >/dev/null 2>&1 && systemctl --user start serge-router.service 2>/dev/null; then :; fi
  WAIT="${SERGE_ROUTER_WAIT:-45}"; i=0
  while [ "$i" -lt "$WAIT" ]; do
    curl -sf "${ROUTER_ROOT}/v1/models" >/dev/null 2>&1 && break
    sleep 1; i=$((i + 1))
  done
fi
if ! curl -sf "${ROUTER_ROOT}/v1/models" >/dev/null 2>&1; then
  echo "serge-engine: no model router at ${OPENAI_BASE_URL}" >&2
  echo "  Start it:  litellm --config ~/.serge/litellm.yaml --port 4000" >&2
  exit 1
fi

exec node "$DIST" "$@"
